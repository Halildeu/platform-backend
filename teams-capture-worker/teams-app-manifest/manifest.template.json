{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.11/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "0.1.0",
  "id": "{{TEAMS_APP_ID}}",
  "packageName": "com.halildeu.meetingcapture",
  "developer": {
    "name": "Halildeu",
    "websiteUrl": "{{PUBLIC_CALLBACK_BASE_URL}}",
    "privacyUrl": "{{PRIVACY_URL}}",
    "termsOfUseUrl": "{{TERMS_URL}}"
  },
  "name": {
    "short": "Meeting Intelligence",
    "full": "Meeting Intelligence toplantı yardımcısı"
  },
  "description": {
    "short": "Toplantı kaydı ve analiz durumunu görünür kılar.",
    "full": "Bot toplantıya görünür kimliğiyle katılır. Ses yalnız kullanıcı onaylı mobil veya masaüstü recorder tarafından işlenir."
  },
  "bots": [
    {
      "botId": "{{BOT_APP_ID}}",
      "scopes": ["personal", "groupchat", "team"],
      "supportsCalling": true,
      "isNotificationOnly": false
    }
  ],
  "validDomains": ["{{PUBLIC_CALLBACK_DOMAIN}}"]
}
