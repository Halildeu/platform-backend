<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- ES-306 (#2665): 3.5.6 carried four Critical findings in the running image —
             three in tomcat-embed-core (10.1.46) and one in spring-security-web (6.5.5),
             all fixed upstream. Bumped within the same minor line so the change is a
             patch train rather than a migration; the sibling services stay on 3.5.6 for
             now and move on their own gates. Verified after the bump by re-resolving the
             two artefacts, not by trusting the release notes. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>ethics-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ethics-service</name>
    <description>Etik Speak isolated public intake, reporter mailbox and staff case API</description>
    <properties>
        <java.version>21</java.version>
        <flyway.version>11.7.2</flyway.version>
        <awssdk.version>2.28.16</awssdk.version>
        <!-- ES-306 (#2665): the running image carried six High findings that the Spring
             Boot 3.5.16 train had not yet picked up. Both are managed by the parent, so
             they are overridden here rather than declared as direct dependencies — the
             version stays a single fact instead of being repeated per artefact.
             netty 4.1.135 → 4.1.136 closes GHSA-6jqx-86gh-f27w, -jppx-w49h-x2qq and
             -mvh2-crg5-v77c in netty-codec-http plus -558v-64gr-wgg4 (netty-codec) and
             -93wv-jw9v-4972 (netty-codec-http2). pgJDBC 42.7.11 → 42.7.12 closes
             GHSA-j92g-9f8w-j867. Verified after the bump by re-resolving and re-scanning
             the built image, not by reading the advisory. -->
        <netty.version>4.1.136.Final</netty.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>common-auth</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- ES-104J (#2929): no-network PDF CDR — parse, inspect for active content,
             render pages to raster and rebuild from scratch. Version pinned exactly;
             the CDR parser IS the security boundary, so it never floats. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
        <!-- ES-104K (#2930): WebP decode, pure Java (read-only plugin). Chosen over a
             native libheif path for THIS format precisely because it keeps the
             request-adjacent sanitizer free of native attack surface; HEIC, which has
             no pure-Java decoder, goes to a separate digest-pinned converter instead.
             Exact pin: the decoder is the security boundary. -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
